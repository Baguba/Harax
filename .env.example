# Harax environment variables — copy this file to .env and adjust
# SQLite database (Prisma). On Railway/Render with a mounted volume, point this at the persistent path.
DATABASE_URL="file:./db/custom.db"

# --- Railway deployment (see RAILWAY_SETUP.md) ---
# On Railway, set this to the mounted volume path so data survives redeploys:
#   DATABASE_URL="file:/data/custom.db"
# Optional: only if you host the chat service somewhere else (must be set at BUILD time):
#   NEXT_PUBLIC_CHAT_URL="wss://chat.your-domain.example"
# CHAT_INTERNAL_TOKEN / CHAT_INTERNAL_URL already have matching defaults in
# both the web app and the chat service — no need to set them on Railway.
