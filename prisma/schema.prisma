generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// HARAX · Haramaya University Community Platform
// Roles: STUDENT | LECTURER | ADMIN | SUPERADMIN
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  avatarUrl    String?
  coverUrl     String?
  role         String   @default("STUDENT")
  department   String?
  year         String?
  bio          String?
  provider     String   @default("credentials") // credentials | google
  verified     Boolean  @default(false)
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  rsvps         Rsvp[]
  eventsMade    Event[]             @relation("EventOrganizer")
  groupsOwned   Group[]             @relation("GroupOwner")
  memberships   GroupMember[]
  channelsOwned Channel[]           @relation("ChannelOwner")
  subscriptions ChannelSubscriber[]
  messages      Message[]
  notifications Notification[]
  reportsFiled  Report[]            @relation("Reporter")
  sessions      Session[]
  gameHosted    GameMatch[]         @relation("GameHost")
  gameJoined    GameMatch[]         @relation("GameGuest")
  seasonScores  SeasonScore[]
  gamePrizes    GameWinner[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mediaUrl  String?
  mediaType String? // image | video
  audience  String   @default("PUBLIC") // PUBLIC | GROUP | CHANNEL
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  likes    Like[]

  @@index([createdAt])
  @@index([groupId])
  @@index([channelId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Like {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction String @default("LIKE") // LIKE | LOVE | FIRE | LAUGH | CLAP
  @@unique([postId, userId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  coverUrl    String?
  location    String
  category    String    @default("CAMPUS") // CAMPUS | ACADEMIC | SPORTS | CULTURE | CLUB | CAREER
  startsAt    DateTime
  endsAt      DateTime?
  organizerId String
  organizer   User      @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  rsvps Rsvp[]
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("GOING") // GOING | INTERESTED
  createdAt DateTime @default(now())
  @@unique([eventId, userId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  emoji       String   @default("💬")
  avatarUrl   String?
  ownerId     String
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  members GroupMember[]
  posts   Post[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // MEMBER | ADMIN
  joinedAt DateTime @default(now())
  @@unique([groupId, userId])
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  handle      String   @unique
  description String?
  avatarUrl   String?
  official    Boolean  @default(false)
  ownerId     String
  owner       User     @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  subscribers ChannelSubscriber[]
  posts       Post[]
}

model ChannelSubscriber {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([channelId, userId])
}

model SideRoom {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  emoji       String
  description String?
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  roomType  String // GROUP | SIDECHAT
  roomId    String
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content   String
  mediaUrl  String?
  mediaType String?
  anonName  String?
  createdAt DateTime @default(now())

  @@index([roomType, roomId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // POST_REACTION | POST_COMMENT | EVENT_NEW | GROUP_ADDED | CHANNEL_POST | SYSTEM
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // POST | USER | COMMENT
  targetId   String
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// GAME ZONE · weekly seasons, matches, points, prizes
// ─────────────────────────────────────────────────────────────

// One row per week. When a season expires the top-3 are awarded
// (GameWinner), it is marked closed and a fresh season begins.
model GameSeason {
  id        String   @id @default(cuid())
  index     Int      @unique // week number since the very first season
  startsAt  DateTime // Monday 00:00 East-Africa time (UTC+3)
  endsAt    DateTime // next Monday 00:00 EAT
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  matches GameMatch[]
  scores  SeasonScore[]
  winners GameWinner[]
}

// A match. state = JSON blob of the engine state (+ move history).
// Sides are per-game symbols: X|O (tic-tac-toe), r|k (checkers), w|b (chess).
// hostColor = the side the host plays; the guest plays the other.
model GameMatch {
  id         String     @id @default(cuid())
  seasonId   String
  season     GameSeason @relation(fields: [seasonId], references: [id])
  game       String // TICTACTOE | CHECKERS | CHESS
  status     String     @default("WAITING") // WAITING | ACTIVE | FINISHED
  vsBot      Boolean    @default(false)
  hostColor  String // X | r | w (or the other symbol)
  playerXId  String // host
  playerX    User       @relation("GameHost", fields: [playerXId], references: [id])
  playerOId  String? // guest (null while WAITING or vs bot)
  playerO    User?      @relation("GameGuest", fields: [playerOId], references: [id])
  winnerId   String? // null = draw / aborted without a winner
  reason     String? // LINE | NO_MOVES | CHECKMATE | STALEMATE | MATERIAL | RESIGN | TIMEOUT | ABANDON | DRAW_AGREED | ABORTED
  state      String // JSON: engine state incl. move list
  turn       String
  lastMoveAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  endedAt    DateTime?

  @@index([status, game, createdAt])
  @@index([seasonId])
  @@index([playerXId])
  @@index([playerOId])
}

// Weekly points ladder — one row per player per season.
model SeasonScore {
  id       String     @id @default(cuid())
  seasonId String
  season   GameSeason @relation(fields: [seasonId], references: [id])
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  points   Int        @default(0)
  wins     Int        @default(0)
  draws    Int        @default(0)
  losses   Int        @default(0)

  @@unique([seasonId, userId])
  @@index([seasonId, points])
}

// Podium of a finished week — the "prize" records.
model GameWinner {
  id        String     @id @default(cuid())
  seasonId  String
  season    GameSeason @relation(fields: [seasonId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank      Int // 1 | 2 | 3
  points    Int
  prize     String
  createdAt DateTime   @default(now())

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
}
